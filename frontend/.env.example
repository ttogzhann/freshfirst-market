VITE_API_BASE_URL=http://127.0.0.1:8000/api
# Must match backend FRESHFIRST_EXPIRY_DAYS. Missing defaults to 3; 0 means today only.
# Nonnegative integer, at most 9007199254740991; blank/negative/fractional values fail.
# Restart Vite / rebuild production assets after changing this build-time value.
VITE_FRESHFIRST_EXPIRY_DAYS=3
