# Install root-owned mode 0600 as /etc/freshfirst/dev.env; generate independent secrets.
POSTGRES_DB=freshfirst_dev
POSTGRES_USER=freshfirst_dev
POSTGRES_PASSWORD=REPLACE_WITH_INDEPENDENT_DEV_PASSWORD
FRESHFIRST_AUTH_SECRET=REPLACE_WITH_INDEPENDENT_DEV_AUTH_SECRET
FRESHFIRST_PORT=127.0.0.1:8081
FRESHFIRST_TRUSTED_ORIGINS=http://127.0.0.1:8081
